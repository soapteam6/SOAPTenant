{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "soap_sharedcommondataserviceforapps_a209b"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "33989072-8708-4754-b47a-45878f042325"
          },
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "List_rows_Accounts": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "20c14b0b-6a05-47cf-ba37-198cb9f5cd0c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "accounts",
              "$select": "accountid,address1_postalcode",
              "$filter": "statecode eq 0 and _soap_territoryid_value eq null and soap_isnamed ne true and address1_postalcode ne null"
            },
            "authentication": {
              "type": "Raw",
              "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
            }
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows_Accounts')?['body/value']",
          "actions": {
            "List_rows_ZipCodes": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "5c8e1600-8d34-4e14-a5a1-c41c7a59ba36"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "soap_zipcodes",
                  "$select": "soap_zipcodeid,_soap_territoryid_value",
                  "$filter": "soap_name eq '@{items('Apply_to_each')?['address1_postalcode']}'",
                  "$top": 1
                },
                "authentication": {
                  "type": "Raw",
                  "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                }
              }
            },
            "ZipCodeNotEmpty": {
              "actions": {
                "Update_Account": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "8268892a-5ef8-4fa9-8327-b11ae98882d0"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "accounts",
                      "recordId": "@items('Apply_to_each')?['accountid']",
                      "item/soap_territoryid@odata.bind": "soap_territories(@{first(outputs('List_rows_ZipCodes')?['body/value'])?['_soap_territoryid_value']})"
                    },
                    "authentication": {
                      "type": "Raw",
                      "value": "@json(decodeBase64(triggerOutputs().headers['X-MS-APIM-Tokens']))['$ConnectionKey']"
                    }
                  }
                }
              },
              "runAfter": {
                "List_rows_ZipCodes": [
                  "Succeeded"
                ]
              },
              "expression": {
                "equals": [
                  "@empty(outputs('List_rows_ZipCodes')?['body/value'])",
                  "@false"
                ]
              },
              "metadata": {
                "operationMetadataId": "ae0d07f2-b5b0-43b9-b72b-dc39e463953e"
              },
              "type": "If"
            }
          },
          "runAfter": {
            "List_rows_Accounts": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "68af3616-3e05-4592-b2c8-79a3406f2aa7"
          },
          "type": "Foreach",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 50
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}