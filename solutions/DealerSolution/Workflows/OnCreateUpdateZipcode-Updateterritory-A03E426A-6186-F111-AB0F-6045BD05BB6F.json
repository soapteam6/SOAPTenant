{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "soap_sharedcommondataserviceforapps_a209b"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "Zipcode": {
          "metadata": {
            "operationMetadataId": "8b7a9392-9c1b-4c02-b65f-b45a86fa5958"
          },
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "soap_zipcode",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "soap_name,soap_territoryid"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "List_rows_Accounts": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "11d7832d-299d-48f2-9b0d-4bcc81856010"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "accounts",
              "$select": "accountid",
              "$filter": "address1_postalcode eq '@{triggerOutputs()?['body/soap_name']}' and soap_isnamed ne true and statecode eq 0"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 100000
            }
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows_Accounts')?['body/value']",
          "actions": {
            "Update_Account": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "89826f12-aa4a-4a6e-9e16-8d40e33787ee"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "accounts",
                  "recordId": "@items('Apply_to_each')?['accountid']",
                  "item/soap_territoryid@odata.bind": "soap_territories(@{triggerOutputs()?['body/_soap_territoryid_value']})"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "List_rows_Accounts": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7c305227-f85a-4487-8a8a-23c40340391f"
          },
          "type": "Foreach"
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}